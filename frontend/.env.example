# Leave empty in development (Vite proxy handles routing to backend)
# Set to your backend URL in production (e.g. https://api.yourdomain.com)
VITE_API_URL=

# AWS Region
VITE_AWS_REGION=us-east-1

# Cognito (optional - backend handles auth, but useful for direct SDK use)
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXX
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
